    <!-- 后台保活设置 -->
    <string name="settings_bg_title">后台运行</string>
    <string name="settings_bg_hide_notif">常驻通知</string>
    <string name="settings_bg_hide_notif_desc">开启后在通知栏显示服务状态；默认关闭，后台更安静</string>

    <string name="settings_bg_hide_from_recents">后台隐藏（最近任务不可见）</string>
    <string name="settings_bg_hide_from_recents_desc">开启后从最近任务列表隐藏本应用，切到后台时不出现在任务切换界面；从桌面图标仍可正常打开</string>

    <string name="settings_bg_battery">电池优化白名单</string>
    <string name="settings_bg_battery_desc">跳转到系统设置，将 GitMount 设为「不优化」，防止系统在后台杀掉服务</string>
    <string name="settings_bg_battery_btn">前往设置</string>
    <string name="settings_bg_battery_err">无法打开电池优化设置</string>

    <string name="settings_bg_auto_start">打开应用时自动启动服务</string>
    <string name="settings_bg_auto_start_desc">进入 App 时自动启动 FTP / WebDAV 服务；开启后也会在手机开机后尝试自动启动（需已配置仓库与访问账号）</string>

    <!-- 静默通知渠道：隐藏通知时使用，Android 8+ 最低优先级，无声音无打扰 -->
    <string name="channel_silent_name">挂载服务（静默）</string>
    <string name="channel_silent_desc">服务在后台运行时使用，已隐藏，不产生通知</string>
